.{
    .name = .preflight,
    .version = "0.18.6",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0x52c46579c2597d2d,
    .paths = .{ "build.zig", "build.zig.zon", "src", "README.md", "CHANGELOG.md", "LICENSE" },
    .dependencies = .{
        .glint = .{
            .url = "git+https://github.com/pedronaugusto/glint?ref=glint-0.8#f6cfbe306990894adedd805ff0bbf810d625c7fe",
            .hash = "glint-0.7.5-3jcpof-bIQBLWMeEemGhQcr5iBvRoTwqUppFJTGjQbj5",
