            .lazy = true,
        },

        // A package's held git (`git` in ci/workflow.json, src/held.zig): the libraries it is
        // built with by zig cc, from their releases, fetched by every build of a package that
        // names a held git (as it configures) and by no other.
        .held_git_zlib = .{
            // zlib v1.4's commit, as GitHub archives it: its tree holds the `configure` the build
            // runs. zlib.net serves only its current release and answers a moved one with an
            // HTML page (riscv64's fetch in run 43773076157).
            .url = "https://github.com/madler/zlib/archive/99623ef7097352da7993ba614161fd6a311e046e.tar.gz",
            .hash = "N-V-__8AADeSNwCAtCXEaVDOpYKVEwzI_t4kH_e8MqWuSIdE",
            .lazy = true,
        },

        .held_git_libressl = .{
            .url = "https://cdn.openbsd.org/pub/OpenBSD/LibreSSL/libressl-4.4.1.tar.gz",
            .hash = "N-V-__8AADBN4gH9JKvGfVRy-_l1AWqXMdYoKyNIC_kQsRms",
            .lazy = true,
        },

        // nghttp2, which the held git's curl speaks HTTP/2 through: GitHub's release asset,
        // immutable (sha256 0cdd35ecec77919b4b7b245f87fe8d2216e3d62da854eb0838c594ff058042fc).
        .held_git_nghttp2 = .{
            .url = "https://github.com/nghttp2/nghttp2/releases/download/v1.71.0/nghttp2-1.71.0.tar.gz",
            .hash = "N-V-__8AAIgi2gCNAFzaSP_Qwb8MVv4GhCI5tn9HjmJdBW5y",
            .lazy = true,
        },

        .held_git_curl = .{
            .url = "https://curl.se/download/curl-8.23.0.tar.xz",
            .hash = "N-V-__8AAMjlVwH79yAHsK65VUcPuhOO6BWgpLDvvnlWPLly",
            .lazy = true,
        },

        // The riscv64 test machine (`-Dci-vm`): Alpine Linux's kernel, its modules and
        // its root file system, fetched only by a build that runs on the machine.
        .alpine_riscv64 = .{
            .url = "https://dl-cdn.alpinelinux.org/alpine/v3.24/releases/riscv64/alpine-uboot-3.24.2-riscv64.tar.gz",
            .hash = "N-V-__8AAK2jSwMxK2QTcDLqXDrakaAa7TS3ShXkjIic0xBt",
            .lazy = true,
        },

        .alpine_riscv64_rootfs = .{
            .url = "https://dl-cdn.alpinelinux.org/alpine/v3.24/releases/riscv64/alpine-minirootfs-3.24.2-riscv64.tar.gz",
            .hash = "N-V-__8AAIMAbQDh5mA2AUF0Pyrm-UxpzkldsIiukdrGCem4",
            .lazy = true,
        },

        // The FreeBSD test machine: FreeBSD 15.1's kernel distribution set and its
        // runtime OCI image (the base system's run-time linker, libc and shell), fetched
        // only by a build that boots it. The release's base.txz cannot be a dependency:
        // Zig's fetch refuses its hard links.
        .freebsd_amd64_kernel = .{
            .url = "https://download.freebsd.org/releases/amd64/15.1-RELEASE/kernel.txz",
            .hash = "N-V-__8AAC_9ngkzIdjDIfoFKFszRY5WsaeewthaOGDNyBWZ",
            .lazy = true,
        },

        .freebsd_amd64_runtime = .{
            .url = "https://download.freebsd.org/releases/OCI-IMAGES/15.1-RELEASE/amd64/Latest/FreeBSD-15.1-RELEASE-amd64-container-image-runtime.txz",
            .hash = "N-V-__8AAGVbtgC1hJ0Cm64qW3BbGIMGb--Sg6Rb7t8GVPbY",
            .lazy = true,
        },

        // Each test machine's own Zig (src/vm.zig's guest_zig_version): ziglang.org's
        // release for the machine's target, which a run naming the build's Zig is given on
        // the machine, fetched only by such a run under `-Dci-vm`.
        .zig_riscv64_linux = .{
            .url = "https://ziglang.org/download/0.17.0/zig-riscv64-linux-0.17.0.tar.xz",
            .hash = "N-V-__8AALRxjBXuerMdVurc3OGo-gkzfgx94L4RFgeMv9LV",
            .lazy = true,
        },

        .zig_x86_64_freebsd = .{
            .url = "https://ziglang.org/download/0.17.0/zig-x86_64-freebsd-0.17.0.tar.xz",
            .hash = "N-V-__8AAECkUBY-WzykR_SsykSjUM4qxLr1QRitEKkOhUK5",
