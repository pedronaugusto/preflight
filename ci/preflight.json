{
  "policy": "family",
  "sources": [
    "src"
  ],
  "test_roots": [
    "src/checks.zig",
    "src/order_test.zig",
    "src/watchdog_test.zig"
  ],
  "test_dependencies": [
    "shakedown"
  ],
  "test_support": [
    "src/testing/**",
    "src/bench_driver.zig"
  ],
  "glint": {
    "rules": [
      {
        "id": "A001",
        "level": "gate"
      },
      {
        "id": "A004",
        "level": "gate"
      },
      {
        "id": "Z026",
        "level": "gate"
      },
      {
        "id": "P003",
        "level": "gate"
      }
    ]
  },
  "fuzz": {
    "trusted": {
      "parseDeadline": "PREFLIGHT_DEADLINE is written by preflight's own run (watchdog.jobDeadline) and read by its test runner: the package's own input, not outside data"
    }
  }
}
